# Copy this file to .env and fill in your own values.

# PostgreSQL connection. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/triage_db

# Secret used to sign login tokens. Use a long random value.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# How long a login lasts, in minutes.
TOKEN_MINUTES=60

# Security (Sprint 5)
# Set to production on a real server: the app then refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development
# Failed sign-ins before an account is locked, and how long the lock lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# How long consultation records are kept. Agree this with your data protection officer.
RETENTION_DAYS=730
